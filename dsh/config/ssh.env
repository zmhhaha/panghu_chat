# DSH_SSH_* environment for the web container.
#
# deploy.sh turns this file into the `dsh-ssh-runtime` ConfigMap. The one value
# that is NOT here is DSH_SSH_HELPER_HASH: it is the digest of the helper
# installed in the runner image, so deploy.sh reads it from rendered/helper.sha256
# instead of having it drift in Git.

# The provider composes against the alias dsh-runner-<project>; config/ssh_config
# expands it to the matching ClusterIP Service. Changing the project means
# changing this line only.
DSH_SSH_HOST=dsh-runner-armbianbegin

# Absolute paths ON THE REMOTE host. dsh-ssh treats all three as required, and
# its README requires Node and the helper to sit outside the workspace and
# outside writable temporary roots -- /opt/dsh-remote satisfies both, so the
# agent cannot edit the code that confines it.
DSH_SSH_NODE=/usr/local/bin/node
DSH_SSH_HELPER=/opt/dsh-remote/node_modules/@deepseek-ai/dsh-ssh/lib/helper.js
DSH_SSH_WORKSPACE=/workspace

# Where the web pod mounts the client key and the pinned host key. The seed step
# copies them out of this read-only mount into ~/.ssh with ssh-compatible modes.
DSH_SSH_SECRET_DIR=/secrets/ssh
