# Copy to build.local.env. Trusted shell configuration, never store passwords here.
REGISTRY=arm-cluster-master:5000
NPM_REGISTRY=https://registry.npmmirror.com
NODE_IMAGE=arm64v8/node:22-bookworm-slim

# Required. Must pin an exact published version; build.sh rejects anything
# without a version and the image build rejects a bare package name.
# Before building, verify on the pinned release that it provides:
#   - the `web` subcommand and its --host/--port/--trusted-host/--no-open flags
#   - the remote filesystem / command / terminal provider family
#   - a switch that disables local execution fallback
# and that a linux-arm64 native package is published for it.
DSH_PACKAGE=deepseek-harness@0.1.6-alpha.2
