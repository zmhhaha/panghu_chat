# Copy to build.local.env. Trusted shell configuration, never store passwords here.
REGISTRY=arm-cluster-master:5000
NPM_REGISTRY=https://registry.npmmirror.com
NODE_IMAGE=arm64v8/node:22-bookworm-slim

# Required. Must pin an exact published version; build.sh rejects anything
# without a version and the image build rejects a bare package name.
#
# Must be the 0.1.6 line. The official SSH provider family (dsh-ssh, dsh-fs-ssh,
# dsh-subprocess-ssh, dsh-sandbox-ssh) is published only there and its peer
# dependencies require it, so build.sh refuses a CLI version that does not match
# DSH_SSH_VERSION below.
#
# Verified on npmjs.org and npmmirror.com on 2026-09-19: `alpha` = 0.1.6-alpha.2
# while `latest` is still 0.1.5-rc.2, which has no SSH provider at all.
DSH_PACKAGE=@deepseek-ai/dsh@0.1.6-alpha.2

# The SSH provider family version. Override only to move both packages together.
DSH_SSH_VERSION=0.1.6-alpha.2
