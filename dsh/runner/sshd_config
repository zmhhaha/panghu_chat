# Non-root sshd for DSH's remote helper.
#
# Started as the unprivileged `dev` user on 2222, so there is no privilege
# separation to rely on inside the container: this file is a transport
# definition, not a security boundary. The boundary is the pod: no cluster
# credentials, read-only root, dropped capabilities.
#
# CORRECTION 2026-09-20: this comment used to end "...and a NetworkPolicy that
# admits only the DSH web workload". Measured on the cluster: the CNI is
# kube-flannel, which does not implement NetworkPolicy, so that rule is inert.
# Do not count network reachability as part of this pod's boundary until a
# policy engine is installed -- see ../../../docs/network-policy-engine.md.

Port 2222
ListenAddress 0.0.0.0

# Host identity comes from the deployment-owned secret, not from a key
# generated at first start. The client pins this key in known_hosts, and
# dsh-ssh requires strict host-key checking, so a regenerated key would be a
# silent outage rather than a recovery.
#
# /state/keys, not /state: sshd applies secure_filename() to the whole path and
# rejects any component that is group- or world-writable. Kubernetes creates
# every writable volume that way -- the emptyDir at /state comes up as
# drwxrwsrwx and a secret volume as drwxrwsrwt -- so the keys live one level
# down, in a directory the prepare-keys init container creates with 0700.
HostKey /state/keys/ssh_host_ed25519_key

# dsh-ssh carries each program stream over its own forwarded Unix socket and
# needs connection multiplexing. Without this the connection is refused
# outright, which is the correct failure mode: better than silently running
# commands somewhere else.
AllowStreamLocalForwarding yes

# NOT `AllowTcpForwarding no`. OpenSSH refuses a streamlocal remote-forward
# request when TCP forwarding is disabled, so that setting silently broke the
# very transport this file exists to serve -- measured: sshd logged
# `Received request ... to remote forward to path "...", but the request was
# denied.` while `sshd -T` still reported allowstreamlocalforwarding yes.
# The exposure stays bounded by what the caller already has: the intended
# client is the DSH web pod, which already has a shell here.
#
# CORRECTION 2026-09-20: the original wording claimed the NetworkPolicy admits
# only that web pod and that the runner's egress is limited to the public
# Internet. Both are currently false -- the CNI is flannel and enforces
# neither, so any pod in the cluster can reach this port. The bound that still
# holds is "a shell the web pod already had", not a network one.
AllowTcpForwarding yes

# Everything else stays off. dsh-ssh disables agent forwarding on its side too;
# this is the server-side half of the same statement.
AllowAgentForwarding no
GatewayPorts no
PermitTunnel no

# Public key only, and only the deployment's own key. No password, no
# keyboard-interactive, no PAM: a non-root sshd cannot do privilege-separated
# authentication anyway, and there is exactly one client.
PubkeyAuthentication yes
AuthorizedKeysFile /state/keys/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no
UsePAM no
PermitEmptyPasswords no

# Exactly one account, and no environment injection through the session.
AllowUsers dev
PermitUserEnvironment no
X11Forwarding no

# The helper process is the only thing that should ever appear here.
MaxSessions 8
MaxStartups 4:30:60
LoginGraceTime 20

# The container has no syslog; sshd logs to stderr and the pod captures it.
SyslogFacility AUTH
LogLevel INFO
