# Copy to build.local.env. Trusted shell configuration, never store passwords here.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
REGISTRY=arm-cluster-master:5000
# Set to your accessible Docker Hub mirror hostname (no https://).
# Empty means use Docker daemon's registry-mirrors.
DOCKERHUB_MIRROR=
# To use a pre-synchronized image instead, set its complete reference:
# HERMES_IMAGE=arm-cluster-master:5000/hermes-agent@sha256:ACTUAL_DIGEST
